 /* This function adds a bookmark to a file.                                */
 /* Returns true on successful bookmark add.                                */
 /* ------------------------------------------------------------------------*/
+/* Audiobook bookmark files hold only their latest position. */
+static bool audiobook_bookmark_file(const char *path)
+{
+    if (strncmp(path, "/<HDD0>", sizeof("/<HDD0>") - 1) == 0)
+        path += sizeof("/<HDD0>") - 1;
+    return strncmp(path, "/Audiobooks/", sizeof("/Audiobooks/") - 1) == 0;
+}
