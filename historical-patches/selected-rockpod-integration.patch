+void ata_set_storage_mode(int mode)
+{
+    bool ssd = (mode == 2) || (mode == 0 && ata_disk_isssd());
+    mutex_lock(&ata_mutex);
+    if (ssd != ata_ssd_mode && !ata_powered)
+    {
+        if (IS_ERR(ata_power_up()))
+        {
+            mutex_unlock(&ata_mutex);
+            return;
+        }
+    }
+    ata_ssd_mode = ssd;
+    mutex_unlock(&ata_mutex);
+}
+
+bool ata_get_ssd_mode(void)
+{
+    return ata_ssd_mode;
