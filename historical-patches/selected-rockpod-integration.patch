 void ata_spin(void)
 {
+    if (ata_ssd_mode && !ata_powered)
+    {
+        mutex_lock(&ata_mutex);
+        if (!ata_powered)
+            ata_power_up();
+        mutex_unlock(&ata_mutex);
+    }
     ata_set_active();
