+/* ATA model words store the first character in the high byte. Match the
+ * explicit adapter brand only; generic SD/CF labels retain existing rules. */
+static bool ata_identify_is_iflash(void)
+{
+    char model[41];
+    for (int i = 0; i < 20; i++)
+    {
+        unsigned short word = identify_info[27 + i];
+        model[2 * i] = word >> 8;
+        model[2 * i + 1] = word & 0xff;
+    }
+    model[40] = '\0';
+    return strstr(model, "iFlash") != NULL;
+}
