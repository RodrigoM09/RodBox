--- /dev/null
+++ b/tests/usb/test_iap_notification_starvation.py
@@ -0,0 +1,84 @@
+"""Replay asynchronous HID completions while PCM keeps reasserting elapsed time."""
+from pathlib import Path
+import os,subprocess,tempfile
+r=Path(__file__).resolve().parents[2]
+b=r/'firmware-source/firmware/usbstack/iap/libiap'
+p=Path(os.environ.get('RODBOX_NOTIFICATION_SOURCE',str(b/'notification.c')))
+notification='\n'.join(l for l in p.read_text().splitlines() if not l.startswith('#include'))
+h=(b/'hid.c').read_text()
+hid=h[h.index('struct ReportSize {'):h.index('static struct ReportSize output_report_size_table_fs')]
+hid+=h[h.index('static struct ReportSize input_report_size_table_hs'):h.index('static struct ReportSize output_report_size_table_hs')]
+hid+=h[h.index('IAPBool iap_notify_send_complete('):]
+pre=r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "iap.h"
+#include "endian.h"
+#include "spec/hid.h"
+#define check_ret(c,r,...) do{if(!(c))return r;}while(0)
+#define check_act(c,a,...) do{if(!(c)){a;}}while(0)
+#define print(...)
+#define warn(...)
+#define array_size(a) (sizeof(a)/sizeof((a)[0]))
+#define min(a,b) ((a)<(b)?(a):(b))
+static uint8_t buffer[256],staging[128];
+static unsigned index3,index4,art3,art4,clock3,contents3,contents4;
+static uint32_t expected_index,expected_caps,expected_count;
+static bool send_ok=true,status_ok=true;static unsigned sequence,index_order,queue_order;
+static struct IAPPlatformPlayStatus status={.state=IAPIPodStatePlayStatus_Playing,.track_count=17};
+struct IAPSpan _iap_get_buffer_for_send_payload(struct IAPContext*c){(void)c;return(struct IAPSpan){buffer,sizeof buffer};}
+int32_t _iap_next_trans_id(struct IAPContext*c){return ++c->trans_id;}
+void*iap_span_alloc(struct IAPSpan*s,size_t n){if(s->size<n)return NULL;void*p=s->ptr;s->ptr+=n;s->size-=n;return p;}
+IAPBool iap_platform_get_play_status(struct IAPContext*c,struct IAPPlatformPlayStatus*p){(void)c;*p=status;return status_ok;}
+int iap_platform_send_hid_report(struct IAPContext*c,const void*p,size_t n){assert(c->send_busy&&p==staging);return send_ok?(int)n:-1;}
+static uint32_t value(const uint8_t*p){return ((uint32_t)p[1]<<24)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<8)|p[4];}
+IAPBool _iap_send_packet(struct IAPContext*c,uint8_t l,uint16_t cmd,int32_t tid,uint8_t*end){
+ assert(!c->send_busy&&tid>0&&end-buffer==5);sequence++;
+ assert(cmd==(l==3?IAPDisplayRemoteCommandID_RemoteEventNotification:IAPExtendedInterfaceCommandID_PlayStatusChangeNotification));
+ unsigned type=buffer[0];
+ if((l==3&&type==1)||(l==4&&type==1)){assert(value(buffer)==expected_index);if(l==3)index3++;else index4++;index_order=sequence;}
+ if((l==3&&type==17)||(l==4&&type==13)){assert(value(buffer)==expected_caps);if(l==3)art3++;else art4++;}
+ if((l==3&&type==18)||(l==4&&type==14)){assert(value(buffer)==expected_count);if(l==3)contents3++;else contents4++;queue_order=sequence;}
+ if(l==3&&type==0)clock3++;
+ return _iap_send_hid_reports(c,0,(size_t)(end-buffer));
+}
+static void advance(struct IAPContext*c,unsigned ticks){
+ for(unsigned n=0;n<ticks;n++){
+  iap_notify_track_time_position(c,n*100);assert(iap_periodic_tick(c));
+  /* The audio producer runs again before the host completes its report. */
+  iap_notify_track_time_position(c,n*100+50);
+  if(c->send_busy)assert(iap_notify_send_complete(c));
+ }
+}
+static void reset_counts(void){index3=index4=art3=art4=clock3=contents3=contents4=sequence=index_order=queue_order=0;}
+'''
+main=r'''
+int main(void){
+ struct IAPContext c={.send_buf=buffer,.hid_send_staging_buf=staging};
+ c.enabled_notifications_3=(1u<<0)|(1u<<1)|(1u<<17)|(1u<<18);
+ /* Automatic advance: no accessory PlayControl and no metadata query. */
+ expected_index=status.track_index=1;expected_caps=status.track_caps=4;
+ iap_notify_track_playback_index(&c,1);advance(&c,20);
+ assert(index3&&art3&&clock3);assert(!(c.notifications_3&((1u<<1)|(1u<<17))));
+ /* Local iPod skip, again without an accessory command. */
+ reset_counts();expected_index=status.track_index=2;expected_caps=status.track_caps=0;
+ iap_notify_track_playback_index(&c,2);advance(&c,20);assert(index3&&art3&&clock3);
+ /* Mixed subscriptions: neither lingo's track identity can sit behind time. */
+ reset_counts();c.enabled_notifications_4=(1u<<1)|(1u<<13)|(1u<<14);
+ expected_index=status.track_index=0;expected_caps=status.track_caps=4;expected_count=17;
+ iap_notify_tracks_count(&c,17);iap_notify_track_playback_index(&c,0);advance(&c,40);
+ assert(index3&&index4&&art3&&art4&&contents3&&contents4&&clock3);assert(queue_order<index_order);
+ /* Backpressure retains the identity; an elapsed-time update cannot replace it. */
+ reset_counts();expected_index=status.track_index=3;iap_notify_track_playback_index(&c,3);
+ c.send_busy=1;for(unsigned n=0;n<10;n++){iap_notify_track_time_position(&c,n*100);assert(iap_periodic_tick(&c));}
+ assert(!index3&&!index4);c.send_busy=0;advance(&c,30);assert(index3&&index4&&art3&&art4);
+ puts("PASS: production notification + asynchronous HID completion replay delivers automatic/local-skip identity and artwork under continuous clock traffic, both lingoes, queue replacement and backpressure");
+}
+'''
+with tempfile.TemporaryDirectory() as d:
+ q=Path(d);(q/'t.c').write_text(pre+notification+hid+main)
+ subprocess.run(['clang','-Wall','-Wextra','-Werror','-fsanitize=address,undefined','-I',str(b),str(q/'t.c'),'-o',str(q/'t')],check=True)
+ subprocess.run([str(q/'t')],check=True)
